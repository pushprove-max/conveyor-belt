{
  "modules": ["./index.tsx"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CONVEYOR_HOOK=1 CONVEYOR_PIN=1 \"${CLAUDE_PLUGIN_ROOT}\"/shim.sh conveyor/foreman/foreman.sh start --rules-apart"
          },
          {
            "type": "command",
            "command": "CONVEYOR_HOOK=1 CONVEYOR_PIN=1 \"${CLAUDE_PLUGIN_ROOT}\"/shim.sh conveyor/foreman/foreman.sh rules || true"
          },
          {
            "type": "command",
            "command": "CONVEYOR_HOOK=1 CONVEYOR_WAITER_START=1 \"${CLAUDE_PLUGIN_ROOT}\"/shim.sh conveyor/foreman/waiter.sh",
            "asyncRewake": true,
            "timeout": 86400
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR:-.}/.conveyor/project.json\" ] || CONVEYOR_HOOK=1 \"${CLAUDE_PLUGIN_ROOT}\"/shim.sh .claude/hooks/board-open.sh",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/ast-grep.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "CONVEYOR_HOOK=1 \"${CLAUDE_PLUGIN_ROOT}\"/shim.sh .claude/hooks/git-safety.sh",
            "timeout": 30,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "CONVEYOR_HOOK=1 \"${CLAUDE_PLUGIN_ROOT}\"/shim.sh .claude/hooks/bash-guardrails.sh",
            "timeout": 30,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "CONVEYOR_HOOK=1 \"${CLAUDE_PLUGIN_ROOT}\"/shim.sh .claude/hooks/adversarial-review-gate.sh",
            "timeout": 120,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "CONVEYOR_HOOK=1 \"${CLAUDE_PLUGIN_ROOT}\"/shim.sh .claude/hooks/dependency-addition-guard.sh",
            "timeout": 60,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "CONVEYOR_HOOK=1 \"${CLAUDE_PLUGIN_ROOT}\"/conveyor/foreman/filing-hook.sh filing"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "CONVEYOR_HOOK=1 \"${CLAUDE_PLUGIN_ROOT}\"/shim.sh .claude/hooks/dependency-addition-guard.sh",
            "timeout": 60,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "CONVEYOR_HOOK=1 \"${CLAUDE_PLUGIN_ROOT}\"/shim.sh .claude/hooks/ruling-cite-gate.sh",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "CONVEYOR_HOOK=1 \"${CLAUDE_PLUGIN_ROOT}\"/shim.sh .claude/hooks/worker-ask-guard.sh",
            "timeout": 30,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "CONVEYOR_HOOK=1 \"${CLAUDE_PLUGIN_ROOT}\"/shim.sh .claude/hooks/ask-records-decision.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CONVEYOR_HOOK=1 \"${CLAUDE_PLUGIN_ROOT}\"/shim.sh .claude/hooks/ruling-log.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "CONVEYOR_HOOK=1 \"${CLAUDE_PLUGIN_ROOT}\"/shim.sh conveyor/foreman/foreman.sh words",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "CONVEYOR_HOOK=1 \"${CLAUDE_PLUGIN_ROOT}\"/shim.sh conveyor/foreman/waiter.sh --check",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CONVEYOR_HOOK=1 \"${CLAUDE_PLUGIN_ROOT}\"/shim.sh conveyor/foreman/waiter.sh --check",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "CONVEYOR_HOOK=1 \"${CLAUDE_PLUGIN_ROOT}\"/shim.sh .claude/hooks/ruling-log.sh",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "CONVEYOR_HOOK=1 \"${CLAUDE_PLUGIN_ROOT}\"/conveyor/foreman/filing-hook.sh filed"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "CONVEYOR_HOOK=1 \"${CLAUDE_PLUGIN_ROOT}\"/conveyor/foreman/filing-hook.sh filed"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CONVEYOR_HOOK=1 \"${CLAUDE_PLUGIN_ROOT}\"/shim.sh conveyor/foreman/stop.sh state"
          },
          {
            "type": "command",
            "command": "CONVEYOR_HOOK=1 \"${CLAUDE_PLUGIN_ROOT}\"/shim.sh conveyor/foreman/stop.sh reply"
          },
          {
            "type": "command",
            "command": "CONVEYOR_HOOK=1 \"${CLAUDE_PLUGIN_ROOT}\"/shim.sh conveyor/foreman/waiter.sh",
            "asyncRewake": true,
            "timeout": 86400
          }
        ]
      }
    ]
  }
}
