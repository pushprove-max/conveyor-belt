{
  "owner": {
    "name": "owner"
  },
  "labels": {
    "built": "awaiting-deploy",
    "followup": "conveyor-followup",
    "type": "bug",
    "priorities": [
      "P0",
      "P1",
      "P2"
    ],
    "areaPrefix": "area:",
    "nonProductAreas": [
      "area:engine",
      "area:board",
      "area:hooks",
      "area:plugin"
    ]
  },
  "productPaths": [
    "site/"
  ],
  "pipelineFiles": [
    "conveyor/conveyor.sh",
    "conveyor/lib/",
    ".conveyor/test-changed.sh",
    ".conveyor/engine-areas.json"
  ],
  "test": {
    "command": "bash .conveyor/test-changed.sh",
    "control": [
      "conveyor/lib/portable.test.sh"
    ],
    "full": "bash .conveyor/test-full.sh",
    "wholeCommands": [
      "conveyor/conveyor.test.sh"
    ],
    "changed": ".conveyor/test-changed.sh",
    "list": "none",
    "fileCommand": "bash .conveyor/test-changed.sh --file",
    "checkCommand": "bash .conveyor/test-changed.sh --checks",
    "map": ".conveyor/engine-areas.json",
    "slowIssues": false,
    "files": {
      "conveyor/conveyor.test.sh": {
        "wholeOnly": true
      }
    },
    "cardFiles": 5
  },
  "linkFromMain": [
    "node_modules"
  ],
  "push": {
    "env": {},
    "check": false
  },
  "remote": "origin",
  "defaultBranch": "main",
  "models": {
    "allowed": {
      "claude": [
        "claude-opus-5-5",
        "claude-fable-5-2",
        "claude-sonnet-5-5",
        "claude-haiku-5-5"
      ],
      "codex": [
        "gpt-6.1-sol",
        "gpt-6-astra",
        "gpt-6.2-sol",
        "gpt-6.2-astra"
      ],
      "claude-reviewer": [
        "claude-opus-5-5",
        "claude-sonnet-5-5",
        "claude-fable-5-2"
      ]
    }
  },
  "review": {
    "proof": "real"
  },
  "privacy": {
    "mode": "public"
  },
  "lanes": {
    "research": {
      "model": "claude-fable-5-2",
      "effort": "medium"
    }
  },
  "plugin": {
    "follow": "main"
  },
  "auto": {
    "standing": [
      "asked-fix",
      "review-followup",
      "release-check",
      "fixed-block",
      "review-retry"
    ]
  }
}
