{
  "owner": {
    "name": "owner"
  },
  "labels": {
    "built": "awaiting-deploy",
    "followup": "conveyor-followup",
    "type": "bug",
    "priorities": [
      "P0",
      "P1",
      "P2"
    ],
    "areaPrefix": "area:",
    "nonProductAreas": [
      "area:engine",
      "area:board",
      "area:hooks",
      "area:plugin"
    ],
    "areaPaths": {
      "paths": {
        "conveyor/tests/": "area:engine/tests",
        "conveyor/foreman/": "area:engine/foreman",
        "conveyor/commands/": "area:engine/commands",
        "conveyor/": "area:engine",
        ".claude/dashboard/": "area:board",
        ".claude/scripts/": "area:board",
        ".claude/hooks/": "area:hooks",
        "hooks/": "area:hooks",
        ".conveyor/lint-funcs.awk": "area:linter",
        ".conveyor/lint-prefix.sh": "area:linter",
        ".conveyor/lint-prefix.test.sh": "area:linter",
        ".conveyor/lint-poll.sh": "area:linter",
        ".conveyor/lint-poll.test.sh": "area:linter",
        ".conveyor/lint-funcs.sh": "area:linter",
        ".conveyor/lint-funcs.test.sh": "area:linter",
        ".conveyor/lint-js.sh": "area:linter",
        ".conveyor/lint-js.test.sh": "area:linter",
        ".conveyor/lint-policy.test.sh": "area:linter",
        ".conveyor/lint-ruff.test.sh": "area:linter",
        ".conveyor/lint-shell.sh": "area:linter",
        ".conveyor/lint-shell.test.sh": "area:linter",
        ".conveyor/": "area:pack",
        "docs/": "area:docs",
        "README.md": "area:docs"
      },
      "other": "area:plugin"
    }
  },
  "productPaths": [
    "site/"
  ],
  "pipelineFiles": [
    "conveyor/conveyor.sh",
    "conveyor/lib/",
    ".conveyor/test-changed.sh",
    ".conveyor/funcs.awk",
    ".conveyor/engine-areas.json"
  ],
  "coverageMap": {
    "command": "bash .conveyor/coverage.sh",
    "file": ".conveyor/coverage.jsonl"
  },
  "test": {
    "command": "bash .conveyor/test-changed.sh",
    "control": [
      "conveyor/lib/portable.test.sh"
    ],
    "full": "bash .conveyor/test-full.sh",
    "wholeCommands": [
      "conveyor/conveyor.test.sh"
    ],
    "changed": ".conveyor/test-changed.sh",
    "list": "none",
    "fileCommand": "bash .conveyor/test-changed.sh --file",
    "checkCommand": "bash .conveyor/test-changed.sh --checks",
    "map": ".conveyor/engine-areas.json",
    "slowIssues": false,
    "files": {
      "conveyor/conveyor.test.sh": {
        "wholeOnly": true
      }
    },
    "cardFiles": 5
  },
  "linkFromMain": [
    "node_modules"
  ],
  "worktree": {
    "setup": "[ -e node_modules ] || npm ci --no-audit --no-fund"
  },
  "push": {
    "env": {},
    "check": false
  },
  "remote": "origin",
  "defaultBranch": "main",
  "models": {
    "allowed": {
      "claude": [
        "claude-opus-5-5",
        "claude-fable-5-2",
        "claude-sonnet-5-5",
        "claude-haiku-5-5"
      ],
      "codex": [
        "gpt-6.1-sol",
        "gpt-6-astra",
        "gpt-6.2-sol",
        "gpt-6.2-astra"
      ],
      "claude-reviewer": [
        "claude-opus-5-5",
        "claude-sonnet-5-5",
        "claude-fable-5-2"
      ]
    }
  },
  "review": {
    "proof": "real"
  },
  "split": {
    "doneWhen": 4,
    "files": 6,
    "chars": 3000
  },
  "privacy": {
    "mode": "public"
  },
  "lanes": {
    "research": {
      "model": "claude-fable-5-2",
      "effort": "medium"
    }
  },
  "plugin": {
    "follow": "main"
  },
  "auto": {
    "standing": [
      "asked-fix",
      "review-followup",
      "release-check",
      "fixed-block",
      "review-retry"
    ]
  },
  "pick": {
    "builder": {
      "claude-opus-5-5": {
        "min": "medium",
        "max": "high"
      }
    },
    "reviewer": {
      "gpt-6.2-sol": {
        "min": "medium",
        "max": "high"
      }
    },
    "judge": {
      "claude-opus-5-5": {
        "min": "medium",
        "max": "high"
      }
    }
  },
  "lint": {
    "commands": [
      {
        "files": [
          "*.sh"
        ],
        "triggers": [
          ".conveyor/lint-shell.sh"
        ],
        "run": "bash .conveyor/lint-shell.sh {files}"
      },
      {
        "files": [
          "conveyor/lib/*.sh",
          "conveyor/commands/*.sh"
        ],
        "triggers": [
          ".conveyor/lint-prefix.sh"
        ],
        "run": "bash .conveyor/lint-prefix.sh {files}"
      },
      {
        "files": [
          ".conveyor/*.test.sh",
          "conveyor/tests/*.test.sh",
          ".claude/hooks/__tests__/*.sh",
          ":(exclude).conveyor/lint-poll.test.sh",
          ":(exclude).conveyor/test-lint.test.sh"
        ],
        "triggers": [
          ".conveyor/lint-poll.sh"
        ],
        "run": "bash .conveyor/lint-poll.sh {files}"
      },
      {
        "files": [
          "*.sh",
          ".conveyor/size-exempt.txt",
          ":(exclude).conveyor/lint-funcs.sh",
          ":(exclude).conveyor/lint-shell.sh",
          ":(exclude).conveyor/lint-js.sh"
        ],
        "ratchet": false,
        "triggers": [
          ".conveyor/lint-funcs.sh",
          ".conveyor/lint-funcs.awk",
          ".conveyor/size-exempt.txt"
        ],
        "run": "bash .conveyor/lint-funcs.sh --max 100 --exempt .conveyor/size-exempt.txt {files}"
      },
      {
        "files": [
          "*.sh",
          "*.py",
          "*.js",
          "*.ts",
          "*.tsx",
          ":(exclude).claude/dashboard/vendor"
        ],
        "triggers": [
          ".conveyor/size-exempt.txt"
        ],
        "size": {
          "file": 800,
          "exempt": ".conveyor/size-exempt.txt"
        }
      },
      {
        "files": [
          "*.py"
        ],
        "triggers": [
          "ruff.toml"
        ],
        "complexity": [
          "C901",
          "PLR0915"
        ],
        "run": "command -v ruff >/dev/null || { echo 'lint: missing ruff'; exit 127; }; ruff check --no-fix --force-exclude --output-format=concise {files}"
      },
      {
        "files": [
          ".claude/dashboard/*.js",
          ":(exclude).claude/dashboard/vendor"
        ],
        "triggers": [
          ".conveyor/lint-js.sh",
          "eslint.config.js",
          "package.json",
          "package-lock.json"
        ],
        "complexity": [
          "complexity",
          "max-lines-per-function",
          "max-depth"
        ],
        "run": "bash .conveyor/lint-js.sh {files}"
      }
    ],
    "policy": [
      ".conveyor/lint-shell.sh",
      ".conveyor/lint-funcs.sh",
      ".conveyor/lint-funcs.awk",
      ".conveyor/size-exempt.txt",
      "ruff.toml",
      ".conveyor/lint-js.sh",
      "eslint.config.js"
    ]
  }
}
