#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# The open issues; with $STUB/list-filed, the follow-ups filed so far are among them, as on GitHub.
issues() { jq -cs '.[0] + .[1:]' "$STUB/issues.json" $([ ! -e "$STUB/list-filed" ] || ls "$STUB/filed" 2>/dev/null); }
# A label made (gh label create): kept in $STUB/labels, never taken for an issue filed.
[ "$1" != label ] || { printf '%s\n' "$*" >> "$STUB/labels"; exit 0; }
case $2 in
  # Without --json, gh prints a table, not JSON: so does this stub, as a caller that reads JSON must ask for it.
  # --json also needs its field list (the next word, not another flag): gh refuses it without.
  list) j=; for a; do [ "$j" != 1 ] || { j=$a; break; }; [ "$a" != --json ] || j=1; done
    [ "$j" != 1 ] || { echo 'flag needs an argument: --json' >&2; exit 1; }
    case $j in ''|-*) printf '#7\tTitle\n'; exit 0 ;; esac
    # Each issue with the fields --json names alone, as gh gives them: a caller that asks for too few is not given more.
    fields() { jq -c --arg f "$j" '($f | split(",")) as $k | map(with_entries(select(.key | IN($k[]))))'; }
    if [ "$4" = closed ]; then echo "$*" >> "$STUB/closed-asked"; [ ! -e "$STUB/closed-fail" ] || exit 1; { cat "$STUB/closed-issues.json" 2>/dev/null || echo '[]'; } | fields; else [ ! -f "$STUB/list-cmd" ] || . "$STUB/list-cmd"
    if [ "$4" = all ]; then issues | jq -c "sort_by(-.number) | .[:$6]" | fields; else issues | jq -c ".[:$6]" | fields; fi; fi ;; # all: newest first, as on GitHub
  # Another repository's issue (gh issue view <n> --repo <owner/repo> --json state): $STUB/repo.<owner_repo>.<n> holds
  # its state, else CLOSED; with $STUB/repo-fail.<owner_repo>, that repository cannot be read. Each ask is a line <owner/repo>#<n> of $STUB/far-viewed.
  view) case "$*" in *' --repo '*) k=${5//\//_}; echo "$5#$3" >> "$STUB/far-viewed"; [ ! -e "$STUB/repo-fail.$k" ] || { echo "GraphQL: Could not resolve to a Repository with the name '$5'. (repository)" >&2; exit 1; }
      echo "{\"state\":\"$(cat "$STUB/repo.$k.$3" 2>/dev/null || echo CLOSED)\"}" ;;
    *'--json closed'*) echo "$3" >> "$STUB/closed-viewed"; [ ! -e "$STUB/closed-fail" ] || exit 1
      jq -c --argjson n "$3" '{closed: any(.[]; .number == $n)}' "$STUB/closed-issues.json" 2>/dev/null || echo '{"closed":false}' ;;
    # closedAt: $STUB/closedAt.<n>, else "" (a closed issue whose closing time GitHub did not give).
    *'--json state'*) echo "{\"state\":\"$(cat "$STUB/state.$3" 2>/dev/null || cat "$STUB/state" 2>/dev/null || echo CLOSED)\",\"closedAt\":\"$(cat "$STUB/closedAt.$3" 2>/dev/null)\"}" ;;
    *) issues | jq --argjson n "$3" '.[] | select(.number == $n)' ;; esac ;;
  # gh api graphql: an issue's fullDatabaseId, a string as GitHub's BigInt (6488700000 + its number: over the 32-bit
  # Int of databaseId, which this stub does not answer, as real ids are), who opened each open issue (an issue's authorAssociation, else OWNER) and its parent and sub-issues
  # ($STUB/subs: a line "<parent> <part>" for each; a part not among the open issues is closed), or when the
  # awaiting-deploy labels were added.
  graphql) case "$*" in *fullDatabaseId*) n=$(printf '%s\n' "$@" | sed -n 's/^number=//p'); echo "{\"data\": {\"repository\": {\"issue\": {\"fullDatabaseId\": \"$((n + 6488700000))\"}}}}" ;;
      # One issue's sub-issues, open or closed (onlyParts, lib/issues.sh onlyparts()): its parts in $STUB/subs, a line
      # "<parent> <part> <OPEN or CLOSED>" each. An issue named in $STUB/deleted (one a line) gets GitHub's NOT_FOUND
      # answer and gh's exit 1.
      *onlyParts*) n=$(printf '%s\n' "$@" | sed -n 's/^n=//p')
        ! grep -qx "$n" "$STUB/deleted" 2>/dev/null || { echo "{\"data\": {\"repository\": {\"nameWithOwner\": \"o/r\", \"issue\": null}}, \"errors\": [{\"type\": \"NOT_FOUND\", \"path\": [\"repository\", \"issue\"], \"message\": \"Could not resolve to an Issue with the number of $n.\"}]}"; exit 1; }
        { cat "$STUB/subs" 2>/dev/null || :; } | jq -cRn --argjson n "$n" '[inputs | split(" ") | select(.[0] == ($n | tostring))]
        | {data: {repository: {nameWithOwner: "o/r", issue: {subIssues: {nodes: map({number: (.[1] | tonumber), state: .[2], repository: {nameWithOwner: "o/r"}})}}}}}' ;;
      # The benefit approvals (lib/benefit.sh benefityes()):the issues the question names, as GitHub's viewer m (the
      # account gh is signed in as) in the repository of the user o. An issue's text is its gqlBody, else its body (a
      # gqlBody differs when the text changed after the list); its author is its author login, else o; its edit history
      # is its edits ([{by, at, text, deleted}], oldest first, the first the text as opened, as GitHub keeps it; a
      # deleted version has no text), of editTotal versions, else as many as it has.
      *userContentEdits*) n=$(printf '%s\n' "$@" | grep -o 'issue(number: [0-9]*' | grep -o '[0-9]*$' | jq -cs .)
        issues | jq -c --argjson ns "$n" '{data: {viewer: {login: "m"}, repository: ({owner: {login: "o"}}
          + (map(select(.number | IN($ns[]))) | map({key: "i\(.number)", value: {number, body: (.gqlBody // .body), author: {login: (.author // "o")},
            userContentEdits: {totalCount: (.editTotal // (.edits // [] | length)), nodes: [.edits // [] | .[]
              | {editedAt: .at, deletedAt: (if .deleted then .at else null end), diff: (if .deleted then null else .text end), editor: {login: .by}}]}}}) | from_entries))}}' ;;
      *authorAssociation*) s=$(jq -cRn '[inputs | split(" ") | map(tonumber)]' "$STUB/subs" 2>/dev/null) || s='[]'
      issues | jq -c --argjson s "${s:-[]}" 'map(.number) as $open | {data: {repository: {nameWithOwner: "o/r", issues: {nodes: map(.number as $n | {number, authorAssociation: (.authorAssociation // "OWNER"),
        parent: ([$s[] | select(.[1] == $n) | {number: .[0], repository: {nameWithOwner: "o/r"}}] | first),
        subIssues: {nodes: [$s[] | select(.[0] == $n) | {number: .[1], state: (if .[1] | IN($open[]) then "OPEN" else "CLOSED" end), repository: {nameWithOwner: "o/r"}}]}}),
        pageInfo: {hasNextPage: false, endCursor: null}}}}}' ;;
      *) [ ! -f "$STUB/labelled" ] || cat "$STUB/labelled" ;; esac ;;
  # gh api .../issues/<p>/sub_issues -F sub_issue_id=<id>: "<p> <part>" added to $STUB/subs (the part's id is
  # 6488700000 + its number, as gh api graphql's fullDatabaseId gives it, above).
  repos/*/sub_issues) p=${2%/sub_issues}; p=${p##*/}; for a; do [[ $a != sub_issue_id=* ]] || echo "$p $((${a#*=} - 6488700000))" >> "$STUB/subs"; done ;;
  # gh api repos/<o>/<r>/issues/<n> -X PATCH -f body=<text>: the issue's body in $STUB/issues.json is that text, and gh
  # prints the issue, its html_url among its fields (a path below the issue, as .../comments, does nothing here).
  repos/*/issues/[0-9]*) n=${2##*/issues/}; [[ $n =~ ^[0-9]+$ ]] || exit 0; for a; do [[ $a != body=* ]] || { jq -c --argjson n "$n" --arg b "${a#body=}" 'map(if .number == $n then .body = $b else . end)' "$STUB/issues.json" > "$STUB/issues.new" && mv -f "$STUB/issues.new" "$STUB/issues.json"; }; done
    echo "{\"number\":$n,\"html_url\":\"https://github.com/o/r/issues/$n\"}" ;;
  # gh auth token: the token gh holds, read without the network (none, with gh's error text, with $STUB/signed-out;
  # timed out, exit 124 as `timeout` gives, with $STUB/token-timeout; an empty token with $STUB/token-empty). gh auth status: the
  # network check, which fails with $STUB/signed-out, and times out (as a GitHub that does not answer) with $STUB/unreached.
  token) [ ! -e "$STUB/token-timeout" ] || exit 124; [ ! -e "$STUB/token-empty" ] || exit 0; [ ! -e "$STUB/signed-out" ] || { echo 'no oauth token found for github.com' >&2; exit 1; }; echo gho_stub ;;
  status) [ ! -f "$STUB/status-cmd" ] || . "$STUB/status-cmd"; [ ! -e "$STUB/unreached" ] || exit 124; [ ! -e "$STUB/signed-out" ] ;;
  # A comment's --body-file <file> is noted as --body <its text>, as a comment given --body is.
  comment) [ ! -f "$STUB/comment-cmd" ] || . "$STUB/comment-cmd"; shift 2; a=()
    while [ $# -gt 0 ]; do if [ "$1" = --body-file ] && [ $# -gt 1 ]; then a+=(--body "$(cat -- "$2")"); shift 2; else a+=("$1"); shift; fi; done
    printf '%s\n' "${a[*]}" >> "$STUB/comments" ;;
  close) echo "$3" >> "$STUB/closed"; shift 3; printf '%s\n' "$*" >> "$STUB/close-comments" ;;
  reopen) echo "$3" >> "$STUB/reopened"; shift 3; printf '%s\n' "$*" >> "$STUB/reopen-comments" ;;
  # gh issue edit <n> --remove-label <label>: the label is taken off the issue's line in $STUB/filed (any other edit is ignored),
  # after $STUB/edit-cmd, when there is one, is sourced (it sees the issue as it was before the edit).
  edit) n=$3; [ ! -f "$STUB/edit-cmd" ] || . "$STUB/edit-cmd"; shift 3; while [ $# -gt 0 ]; do [ "$1" != --remove-label ] || { jq -c --argjson n "$n" --arg l "$2" 'if .number == $n then .labels |= map(select(.name != $l)) else . end' "$STUB/filed" > "$STUB/filed.new" && mv -f "$STUB/filed.new" "$STUB/filed"; }; shift; done ;;
  create) shift 2; n=$((100101 + $(cat "$STUB/filed" 2>/dev/null | wc -l))); l=(); m=
    [ ! -f "$STUB/create-cmd" ] || . "$STUB/create-cmd"
    # The option that gave the body (--body or --body-file) is noted in $STUB/body-from, a line per issue filed.
    while [ $# -gt 0 ]; do case $1 in --title) t=$2 ;; --body) b=$2; echo "$1" >> "$STUB/body-from" ;; --body-file) b=$(cat -- "$2"); echo "$1" >> "$STUB/body-from" ;; --label) l+=("$2") ;; --milestone) m=$2 ;; esac; shift 2; done
    jq -cn --argjson n "$n" --arg t "$t" --arg b "$b" --arg m "$m" '{number:$n,title:$t,body:$b,milestone:(if $m == "" then null else {title:$m} end),
      createdAt:"2026-12-01",labels:($ARGS.positional|map({name:.}))}' --args "${l[@]}" >> "$STUB/filed"
    echo "https://github.com/o/r/issues/$n" ;;
esac
