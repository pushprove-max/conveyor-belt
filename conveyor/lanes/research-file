#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# research-file <title> < <body> -- the research lane's filing command, its one way to GitHub: the lane's shell
# (research-bash) has no network, so a command in it reaches GitHub only by this. It sends the title and the body (its
# input) to the filer the lane's shell runs outside its sandbox (on file descriptors 7 and 6), and prints the new
# issue's link. Exit 1 when the issue was not filed, or was filed and not held, saying why.
# research-file --serve: the filer (research-bash runs it, outside the sandbox, in the lane's worktree, with
# CONVEYOR_LANE=research and CONVEYOR_FOREMAN_DIR the filer's folder, which the sandbox cannot write): for each request
# it reads (a JSON line, {title, body}), it files the issue in the worktree's repository (gh issue create) as the
# Foreman's filing and filed hooks file one (foreman/foreman.sh): every record starts new issues held first, the issue
# is held, then they start them in the queue again; a record it cannot set held files nothing. One filer of the lane
# files at a time (filing.lock in its folder), so none starts new issues in the queue again while another is filing,
# and nor does the lane's own filed hook, which waits for its turn too (foreman/foreman.sh, queue_again).
# It answers with a JSON line, {ok, out}.
set -uo pipefail
HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)

serve() {
  local req
  exec 5>>"${CONVEYOR_FOREMAN_DIR:?}/filing.lock" || exit 1
  while IFS= read -r req; do
    if flock 5; then file1 "$req" 5>&-; flock -u 5; else reply false "the filer could not wait its turn to file"; fi
  done
}
file1() {
  local t b out r rc why
  t=$(jq -r '.title | strings' <<<"$1" 2>/dev/null) b=$(jq -r '.body | strings' <<<"$1" 2>/dev/null)
  [ -n "$t" ] || { reply false "a request with no title files nothing"; return; }
  out=$(jq -cn '{hook_event_name: "PreToolUse", tool_name: "Bash", tool_input: {command: "gh issue create"}}' \
    | bash "$HERE/../foreman/foreman.sh" filing 2>&1) || { reply false "new issues could not be set to start held: ${out##*$'\n'}"; return; }
  why=$(jq -r '.hookSpecificOutput.permissionDecisionReason // empty' <<<"$out" 2>/dev/null)
  [ -z "$why" ] || { reply false "$why"; return; }
  r=$(gh issue create --title "$t" --body-file - <<<"$b" 2>&1); rc=$?
  out=$(jq -cn --arg r "$r" '{hook_event_name: "PostToolUse", tool_name: "Bash", tool_input: {command: "gh issue create"},
    tool_response: {stdout: $r, stderr: ""}}' | bash "$HERE/../foreman/foreman.sh" filed 2>&1)
  why=$(jq -r '.reason // empty' <<<"$out" 2>/dev/null)
  if [ "$rc" = 0 ] && [ -z "$why" ]; then reply true "$r"; else reply false "$r${why:+ $why}"; fi
}
reply() { jq -cn --argjson ok "$1" --arg o "$2" '{ok: $ok, out: $o}'; }

case ${1:-} in
  --serve) [ $# = 1 ] && serve; exit ;;
  '' | -*) echo "usage: research-file <title> < <body>" >&2; exit 2 ;;
esac
[ $# = 1 ] || { echo "usage: research-file <title> < <body>" >&2; exit 2; }
{ : >&7 && : <&6; } 2>/dev/null || { echo "research-file: no filer here: run it in the research lane's shell" >&2; exit 1; }
jq -cn --arg t "$1" --rawfile b /dev/stdin '{title: $t, body: $b}' >&7 || exit 1
IFS= read -r r <&6 || { echo "research-file: the filer gave no answer" >&2; exit 1; }
if jq -e .ok <<<"$r" >/dev/null 2>&1; then jq -r .out <<<"$r"; else echo "research-file: not filed held: $(jq -r .out <<<"$r")" >&2; exit 1; fi
